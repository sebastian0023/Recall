PORT=3000
NODE_ENV=development

# Base de datos (PostgreSQL en Docker: docker compose up -d)
DATABASE_URL=postgresql://recall:recall@localhost:5432/recall
POSTGRES_USER=recall
POSTGRES_PASSWORD=recall
POSTGRES_DB=recall

# "dummy": register/login solo usan la BD y no se exige token (para probar el API sin Cognito)
# "cognito": autenticación real con Amazon Cognito (requiere las variables COGNITO_*)
AUTH_MODE=dummy

# Solo se usan con AUTH_MODE=cognito
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Solo si el app client tiene client secret
COGNITO_CLIENT_SECRET=

# Siguientes entregas
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=recall-audio-dev
BEDROCK_MODEL_ID=
