PORT=3000
NODE_ENV=development

# Logs (pino). Nivel mínimo que se escribe: fatal, error, warn, info, debug, trace o silent.
# Con NODE_ENV=production salen en JSON (una línea por evento); en desarrollo, en formato legible.
LOG_LEVEL=info

# Base de datos (PostgreSQL en Docker: docker compose up -d)
DATABASE_URL=postgresql://recall:recall@localhost:5432/recall
POSTGRES_USER=recall
POSTGRES_PASSWORD=recall
POSTGRES_DB=recall

# Sesión (JWT firmado con HS256)
# JWT_SECRET: mínimo 32 caracteres. El valor de ejemplo sirve solo para desarrollo y se rechaza con NODE_ENV=production.
#   Genera uno propio con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_EXPIRES_IN: duración del token en segundos ("3600") o con unidad ("30s", "15m", "1h", "7d")
JWT_SECRET=dev-only-secret-change-me-before-deploying-0123456789
JWT_EXPIRES_IN=1h

# Tokens de un solo uso (enlaces que se mandan por correo). Mismo formato que JWT_EXPIRES_IN
# VERIFY_TOKEN_TTL: vigencia del enlace de verificación de correo. RESET_TOKEN_TTL: del de recuperar contraseña.
VERIFY_TOKEN_TTL=24h
RESET_TOKEN_TTL=1h

# Correo (nodemailer). Los valores de abajo apuntan a Mailpit, que se levanta con `docker compose up -d`
# y muestra los correos en http://localhost:8025 sin mandar nada a internet. Para Ethereal, Mailtrap o un SMTP
# real solo cambian estas variables. SMTP_USER y SMTP_PASS se dejan vacías si el servidor no pide autenticación.
# APP_URL: dirección pública del API; con ella se arman los enlaces de los correos.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Recall <no-reply@recall.local>
APP_URL=http://localhost:3000

# Login con Google (opcional; sin estas variables el botón no aparece)
# Crea un "OAuth client ID" tipo Web en https://console.cloud.google.com/apis/credentials y autoriza
# como "Authorized redirect URI" exactamente el valor de GOOGLE_CALLBACK_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/google_confirm

# Siguientes entregas
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=recall-audio-dev
BEDROCK_MODEL_ID=
