generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum AuthTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum RecordingStatus {
  UPLOADED
  PROCESSING
  DONE
  FAILED
}

enum SummaryTemplate {
  MEETING
  CLASS
  INTERVIEW
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  passwordHash  String? // bcrypt; nulo para usuarios que entran solo con un proveedor externo
  name          String
  role          UserRole @default(USER)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  recordings Recording[]
  authTokens AuthToken[]
}

// Tokens de un solo uso (verificar correo, recuperar contraseña). Solo se guarda el sha256 del token
model AuthToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model Recording {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @db.Uuid
  title           String
  s3Key           String
  durationSec     Int?
  status          RecordingStatus @default(UPLOADED)
  transcribeJobId String?
  errorMessage    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  transcription Transcription?
  summaries     Summary[]

  @@index([userId])
}

model Transcription {
  id          String   @id @default(uuid()) @db.Uuid
  recordingId String   @unique @db.Uuid
  language    String   @default("es-US")
  fullText    String
  segments    Json? // [{ speaker, startMs, endMs, text }]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recording Recording @relation(fields: [recordingId], references: [id], onDelete: Restrict)
}

model Summary {
  id          String          @id @default(uuid()) @db.Uuid
  recordingId String          @db.Uuid
  template    SummaryTemplate
  content     String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  recording Recording @relation(fields: [recordingId], references: [id], onDelete: Restrict)

  @@index([recordingId])
}
