<section class="login">
  <h1>Recuperar contraseña</h1>
  {{#if sent}}
    <p class="success-text">{{message}}</p>
    <p class="muted">El enlace es de un solo uso y vence pronto. Si no llega, revisa tu carpeta de spam.</p>
    <p class="switch"><a href="/login">Volver a iniciar sesión</a></p>
  {{else}}
    {{#if error}}<p class="error-text">{{error}}</p>{{/if}}
    <p class="muted">Escribe tu correo y te mandamos un enlace para crear una contraseña nueva.</p>
    <form method="post" action="/forgot-password">
      <label for="email">Correo</label>
      <input id="email" name="email" type="email" autocomplete="email" required>
      <button type="submit">Enviar enlace</button>
    </form>
    <p class="switch"><a href="/login">Volver a iniciar sesión</a></p>
  {{/if}}
</section>
