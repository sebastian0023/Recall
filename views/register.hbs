<section class="login">
  <h1>Crear cuenta</h1>
  {{#if errors.length}}
    <ul class="error-text error-list">
      {{#each errors}}<li>{{this}}</li>{{/each}}
    </ul>
  {{/if}}
  <form method="post" action="/register">
    <label for="name">Nombre</label>
    <input id="name" name="name" type="text" autocomplete="name" maxlength="100" value="{{name}}" required>
    <label for="email">Correo</label>
    <input id="email" name="email" type="email" autocomplete="email" value="{{email}}" required>
    <label for="password">Contraseña</label>
    <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="72" required>
    <button type="submit">Crear cuenta</button>
  </form>
  {{#if googleEnabled}}
    <div class="divider"><span>o</span></div>
    <a class="google-btn" href="/auth/google">Continuar con Google</a>
  {{/if}}
  <p class="switch">¿Ya tienes cuenta? <a href="/login">Iniciar sesión</a></p>
</section>
