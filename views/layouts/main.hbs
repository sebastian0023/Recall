<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}} · Recall</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">Recall</a>
    {{#if user}}
      <nav>
        <a href="/">Inicio</a>
        <a href="/recordings">Grabaciones</a>
        {{#if (eq user.role "ADMIN")}}<a href="/users">Usuarios</a>{{/if}}
        <span class="muted">{{user.name}} ({{roleLabel user.role}})</span>
        <form class="inline" method="post" action="/logout"><button type="submit">Salir</button></form>
      </nav>
    {{/if}}
  </header>

  {{#if user}}{{#unless user.emailVerified}}
    <div class="notice notice-warning">
      <span>Tu correo no está verificado. Hasta que lo verifiques no puedes subir ni procesar grabaciones.</span>
      <form class="inline" method="post" action="/resend-verification"><button type="submit">Reenviar enlace</button></form>
    </div>
  {{/unless}}{{/if}}

  <main class="container">
    {{#if notice}}<p class="notice">{{notice}}</p>{{/if}}
    {{{body}}}
  </main>

  <footer class="footer">Recall · Tecnologías de desarrollo en el servidor · ITESO</footer>
</body>
</html>
